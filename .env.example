# Este archivo es un fallback genérico. En la práctica, cada modo tiene su propio valor
# (ya committeados porque no son secretos, solo URLs base):
#   .env.development → VITE_API_BASE_URL=/api (relativo, usa el proxy de Vite — ver vite.config.ts)
#   .env.production   → URL absoluta (build empaquetado) — ver ese archivo para el detalle de
#                        10.0.2.2 (emulador Android) vs localhost (simulador iOS)
# Ver spec/constitution/api-integration.md §1/§3 y spec/features/002-autenticacion/plan.md y
# spec/features/003-autenticacion-nativa/plan.md.
VITE_API_BASE_URL=http://localhost:3000/api

# Timeout de requests HTTP en milisegundos (opcional, default 15000).
VITE_API_TIMEOUT_MS=15000

# Monitoreo de fallos (Sentry, capa gratuita) — opcional. Sin este DSN, initMonitoring() no hace
# nada (ver services/telemetry/monitoring.ts). Nunca es un secreto de servidor: cualquier valor
# embebido en el bundle de la app es público por definición (tech-stack.md §11), un DSN de Sentry
# solo permite *enviar* eventos, no leer datos de otros proyectos.
VITE_SENTRY_DSN=

# Versión mostrada como "release" en el monitoreo de fallos (opcional, default 0.0.0).
# En CI puede inyectarse desde package.json/tag de git antes del build.
VITE_APP_VERSION=0.0.1
